{
  "name": "demo-site",
  "version": "0.1.0",
  "private": true,
  "description": "Interactive CodeRabbit feature tour with JSON-managed navigation and video demos",
  "type": "module",
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitest/coverage-v8": "5.0.0",
    "eslint": "10.10.0",
    "jsdom": "29.1.1",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.69.0",
    "vite": "8.2.2",
    "vitest": "5.0.0"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run validate:tour && npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "validate:tour": "node scripts/validate-tour.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "security:check": "npm audit --audit-level=low",
    "check": "npm run format:check && npm run lint && npm run build && npm run test:coverage && node --test scripts/publish-media.node-test.mjs"
  }
}
